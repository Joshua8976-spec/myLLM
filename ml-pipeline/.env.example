# =====================================================================
# StudyVerse Custom LLM Configuration (.env.example)
#
# Primary Hosting: Modal Cloud GPU (modal.com)
# Provides OpenAI-compatible /v1/chat/completions with streaming SSE
# and dynamic GPU scaling.
# =====================================================================

# ---------------------------------------------------------------------
# Option 1: Modal Cloud GPU Endpoint (ml-pipeline/serve_llm_modal.py)
# ---------------------------------------------------------------------
# Set to your deployed Modal endpoint URL (including /v1):
VITE_STUDY_LLM_URL=https://rockefashy--studyverse-qwen-serve-serve.modal.run/v1
VITE_STUDY_LLM_MODEL=studyverse-qwen-2.5-3b

# Optional API Key if configured in your server:
# VITE_STUDY_LLM_API_KEY=

# ---------------------------------------------------------------------
# Option 2: Local Ollama (Local Development / Offline)
# ---------------------------------------------------------------------
# VITE_STUDY_LLM_URL=http://localhost:11434/v1
# VITE_STUDY_LLM_MODEL=qwen2.5:3b

# ---------------------------------------------------------------------
# Option 3: Groq Cloud Inference (Optional Fallback)
# ---------------------------------------------------------------------
# VITE_STUDY_LLM_URL=https://api.groq.com/openai/v1
# VITE_STUDY_LLM_MODEL=llama-3.1-8b-instant
# VITE_STUDY_LLM_API_KEY=gsk_your_groq_api_key_here
