# =====================================================================
# StudyVerse Custom LLM Configuration (.env.example)
#
# Supports:
# 1. Groq Cloud (Free Tier & High-Performance Inference)
# 2. Modal (modal.com Cloud GPU Deployment)
# 3. Hugging Face Space (Free CPU Basic Docker Space)
# 4. Local Offline Ollama (100% $0 Local Execution)
# =====================================================================

# ---------------------------------------------------------------------
# Option 1: Groq Cloud Inference (Recommended for sub-second responses)
# ---------------------------------------------------------------------
# Base URL for Groq's OpenAI-compatible completions endpoint:
VITE_STUDY_LLM_URL=https://api.groq.com/openai/v1

# Groq Model ID (e.g. llama-3.1-8b-instant, qwen-2.5-32b, llama-3.3-70b-versatile)
VITE_STUDY_LLM_MODEL=llama-3.1-8b-instant

# Groq API Key (obtain free key at https://console.groq.com/keys)
# For production environments, proxy requests via backend or edge function
# to avoid exposing client-side credentials.
VITE_STUDY_LLM_API_KEY=gsk_your_groq_api_key_here


# ---------------------------------------------------------------------
# Option 2: Modal Cloud GPU Endpoint (ml-pipeline/serve_llm_modal.py)
# ---------------------------------------------------------------------
# VITE_STUDY_LLM_URL=https://<your-org>--studyverse-qwen-serve-modelserver-chat-completions.modal.run/v1
# VITE_STUDY_LLM_MODEL=studyverse-qwen-2.5-3b


# ---------------------------------------------------------------------
# Option 3: Free Hugging Face Space (Custom Fine-Tuned GGUF)
# ---------------------------------------------------------------------
# VITE_STUDY_LLM_URL=https://YOUR_SPACE_NAME.hf.space/v1
# VITE_STUDY_LLM_MODEL=qwen2.5-3b


# ---------------------------------------------------------------------
# Option 4: Local Ollama (Local Development / Offline)
# ---------------------------------------------------------------------
# VITE_STUDY_LLM_URL=http://localhost:11434/v1
# VITE_STUDY_LLM_MODEL=qwen2.5:3b
